{
  "name": "expo-app",
  "homepage": "https://skaterdenni-coder.github.io/Realisierung-BA/",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npx expo start --port 8081",
    "start-tunnel": "npx expo start --port 8081 --tunnel",
    "start-web": "npx expo start --web --port 8081",
    "start-web-tunnel": "npx expo start --web --port 8081 --tunnel",
    "start-web-dev": "DEBUG=expo* npx expo start --web --port 8081",
    "predeploy": "bunx expo export -p web && node -e \"require('fs').writeFileSync('dist/.nojekyll', '')\" && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "deploy": "gh-pages -d dist",
    "lint": "expo lint",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
