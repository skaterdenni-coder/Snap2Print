{
  "expo": {
    "name": "Snap2Print",
    "slug": "snap2print",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "snap2print",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.snap2print"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.snap2print"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "output": "static",
      "homepage": "https://skaterdenni-coder.github.io/Snap2Print/",
      "baseUrl": "/Snap2Print"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://skaterdenni-coder.github.io/Snap2Print/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "./plugins/withAndroidLargeHeap"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/Snap2Print"
    }
  }
}
